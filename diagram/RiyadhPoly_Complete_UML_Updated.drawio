          <mxGeometry height="24" width="240" y="110" as="geometry" />
        </mxCell>
        <mxCell id="class_25_method_0" parent="class_25" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Recursive;fontSize=14;spacingLeft=12;spacingRight=12;overflow=hidden;rotatable=0;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fontStyle=4;labelBackgroundColor=none;fontColor=#000000;fillColor=none;strokeColor=none;" value="+main(args: String[]) void" vertex="1">
          <mxGeometry height="26" width="240" y="134" as="geometry" />
        </mxCell>
        <mxCell id="class_25_method_1" parent="class_25" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Recursive;fontSize=14;spacingLeft=12;spacingRight=12;overflow=hidden;rotatable=0;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fontStyle=4;labelBackgroundColor=none;fontColor=#000000;fillColor=none;strokeColor=none;" value="+testFullGroupRent() void" vertex="1">
          <mxGeometry height="26" width="240" y="160" as="geometry" />
        </mxCell>
        <mxCell id="class_25_method_2" parent="class_25" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Recursive;fontSize=14;spacingLeft=12;spacingRight=12;overflow=hidden;rotatable=0;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fontStyle=4;labelBackgroundColor=none;fontColor=#000000;fillColor=none;strokeColor=none;" value="+testBuyOut() void" vertex="1">
          <mxGeometry height="26" width="240" y="186" as="geometry" />
        </mxCell>
        <mxCell id="note_Scope" parent="whole-project-design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=12;spacingBottom=12;fontFamily=Recursive;fontSize=14;labelBackgroundColor=none;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="WHOLE-PROJECT DESIGN&lt;br&gt;Phase 1 requires this whole design, while implementation only loads and prints the&lt;br&gt;board. Player and Game are empty stubs in Phase 1.&lt;br&gt;Phase 2: Player, both bots, Dice, game loop, money, leaderboard and RentTest.&lt;br&gt;Phase 3: ChanceDeck / cards, jail, bankruptcy and final standings.&lt;br&gt;Later-phase members are a proposed design from the overview; exact signatures may&lt;br&gt;change with the detailed Phase 2/3 briefs." vertex="1">
          <mxGeometry height="179" width="650" x="3014" y="-614" as="geometry" />
        </mxCell>
        <mxCell id="note_BoardRules" parent="whole-project-design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=12;spacingBottom=12;fontFamily=Recursive;fontSize=14;labelBackgroundColor=none;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="BOARD FILE AND VALIDATION - PHASE 1&lt;br&gt;Read 20 ordered squares from board.txt:&lt;br&gt;index,type,name,group,price,rent. Ignore # comments; preserve&lt;br&gt;trailing empty fields with split(&quot;,&quot;, -1). Do not hard-code square&lt;br&gt;data.&lt;br&gt;Build Map&amp;lt;String, ArrayList&amp;lt;Ownable&amp;gt;&amp;gt; as records load. countOwned&lt;br&gt;returns 0 for non-null players while all owners are null." vertex="1">
          <mxGeometry height="179" width="520" x="3293" y="1501.5" as="geometry" />
        </mxCell>
        <mxCell id="note_FileErrors" parent="whole-project-design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=12;spacingBottom=12;fontFamily=Recursive;fontSize=14;labelBackgroundColor=none;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="CHECKED EXCEPTION&lt;br&gt;Missing file or invalid record: print a clear error and stop. Include&lt;br&gt;actual file line number and reason for malformed records; wrap&lt;br&gt;NumberFormatException." vertex="1">
          <mxGeometry height="116" width="520" x="5227" y="1861" as="geometry" />
        </mxCell>
        <mxCell id="note_Constants" parent="whole-project-design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=12;spacingBottom=12;fontFamily=Recursive;fontSize=14;labelBackgroundColor=none;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="CONSTANTS&lt;br&gt;All five ColorGroup strings, BOARD_SIZE = 20, CSV_FIELD_COUNT = 6&lt;br&gt;and every fixed game number are static final. Underlined members&lt;br&gt;are static; italic operations are abstract." vertex="1">
          <mxGeometry height="116" width="520" x="-97" y="1880" as="geometry" />
        </mxCell>
        <mxCell id="note_PlayerRules" parent="whole-project-design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=12;spacingBottom=12;fontFamily=Recursive;fontSize=14;labelBackgroundColor=none;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="BOT RULES AND LEADERBOARD&lt;br&gt;CautiousBot buys only if at least $300 remains after purchase.&lt;br&gt;AggressiveBot buys whenever it can afford the square. Both override&lt;br&gt;wantsToBuy(Ownable).&lt;br&gt;Player implements Comparable&amp;lt;Player&amp;gt; using net worth: cash plus&lt;br&gt;purchase value of owned squares. Sort for the displayed leaderboard&lt;br&gt;without changing turn order." vertex="1">
          <mxGeometry height="179" width="520" x="6603" y="1368" as="geometry" />
        </mxCell>
        <mxCell id="note_GameRules" parent="whole-project-design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=12;spacingBottom=12;fontFamily=Recursive;fontSize=14;labelBackgroundColor=none;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="MONEY, JAIL AND BANKRUPTCY&lt;br&gt;Whole-group ownership doubles base rent. Owning all but one square&lt;br&gt;permits a 1.5 x price buy-out of the last square from its owner.&lt;br&gt;Update both owners&#39; property lists.&lt;br&gt;Jail skips one turn. Remove players whose cash is below 0 using&lt;br&gt;Iterator&amp;lt;Player&amp;gt;.remove(); return their squares to the bank. After&lt;br&gt;20 rounds, highest net worth wins." vertex="1">
          <mxGeometry height="179" width="520" x="3443" y="885" as="geometry" />
        </mxCell>
        <mxCell id="note_InputRules" parent="whole-project-design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=12;spacingBottom=12;fontFamily=Recursive;fontSize=14;labelBackgroundColor=none;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="INPUT AND POLYMORPHISM&lt;br&gt;Use Scanner to validate the optional seed, four names, and C/A bot&lt;br&gt;choices. Seed Dice for repeatable rolls.&lt;br&gt;Game code calls Square.land(player, game),&lt;br&gt;Player.wantsToBuy(ownable) and ChanceCard.apply(player, game)&lt;br&gt;through their abstract parent types." vertex="1">
          <mxGeometry height="158" width="520" x="2463" y="250" as="geometry" />
        </mxCell>
        <mxCell id="note_DeckRules" parent="whole-project-design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=12;spacingBottom=12;fontFamily=Recursive;fontSize=14;labelBackgroundColor=none;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" value="SHARED CHANCE DECK - PHASE 3&lt;br&gt;Store cards in ArrayList&amp;lt;ChanceCard&amp;gt;. Drawing cycles the first card&lt;br&gt;to the end of the list. MoneyCard adds or deducts money; MoveCard&lt;br&gt;moves; GoToJailCard sends the player to jail.&lt;br&gt;ChanceSquare draws from Game&#39;s shared deck. Player and Game in&lt;br&gt;card signatures are parent types, not specific subclasses." vertex="1">
          <mxGeometry height="158" width="520" x="4459" y="1401" as="geometry" />
        </mxCell>
        <mxCell id="edge_0" edge="1" parent="whole-project-design" source="class_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;fontColor=#000000;fontFamily=Recursive;fontSize=12;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;startArrow=block;startSize=12;startFill=0;endArrow=none;exitX=1;exitY=0.913907;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;curved=0;strokeColor=light-dark(#000000,#121212);" target="class_2" value="">
